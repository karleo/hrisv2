APP_NAME="Biometric Relay"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=single,relay
LOG_LEVEL=info

CACHE_STORE=file

# LAN device
RELAY_DEVICE_HOST=192.168.1.44
RELAY_DEVICE_SERIAL=OAE7050057042700029
RELAY_DEVICE_TIMEZONE=Asia/Dubai
RELAY_DEVICE_PORT=80
RELAY_DEVICE_WEB_USERNAME=administrator
RELAY_DEVICE_WEB_PASSWORD=
RELAY_DEVICE_WEB_SESSION_ID=
RELAY_DEVICE_TIMEOUT=30

# AWS HRIS endpoints (HTTP for /iclock/cdata)
RELAY_CDATA_URL=http://hris-stag.primelogistics.ae/iclock/cdata
RELAY_HEALTH_URL=http://hris-stag.primelogistics.ae/api/biometric/relay/health
RELAY_HEARTBEAT_URL=http://hris-stag.primelogistics.ae/api/biometric/relay/heartbeat
RELAY_TOKEN=change-me-to-a-long-secret
RELAY_CHUNK_SIZE=200
RELAY_BOOTSTRAP_DAYS=7
